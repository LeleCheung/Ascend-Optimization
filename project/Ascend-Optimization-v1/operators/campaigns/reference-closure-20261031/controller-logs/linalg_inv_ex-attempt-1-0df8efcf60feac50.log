  "content": "\"\"\"Decisive test: can the A^T route reproduce the singular reference bit-for-bit?\n\nOne compilation (BLOCK_N=4) computes the inverse twice inside the same kernel\n(rounded-reciprocal scaling vs per-element division), both with the plain\n`work - x*u` update that this backend lowers as mul+sub.  Index-based\ntransposed access avoids tl.trans (suspected small-block layout bug).\n\nnumpy references for both rounding hypotheses are computed alongside so the\nTriton numerics can be compared with the emulation as well.\n\"\"\"\n\nimport json\nimport os\n\nimport numpy as np\nimport torch\nimport triton\nimport triton.language as tl\nfrom flag_gems.runtime import torch_device_fn\n\nOUT = os.environ.get(\"KGS_DEBUG_ARTIFACTS\", \".\")\n\n\n@triton.jit\ndef dual(A, INR, IND, IFR, INFI, LUR, LUD,\n         N: tl.constexpr, BLOCK_N: tl.constexpr, USE_FMA: tl.constexpr):\n    pid = tl.program_id(0)\n    rows = tl.arange(0, BLOCK_N)\n    cols = tl.arange(0, BLOCK_N)\n    m = (rows[:, None] < N) & (cols[None, :] < N)\n    base = pid * N * N\n\n    wr = tl.load(A + base + cols[None, :] * N + rows[:, None], mask=m, other=0.0).to(tl.float32)\n    wd = wr\n\n    sr = 0\n    sd = 0\n    pr = tl.zeros((BLOCK_N,), tl.int32)\n    pd = tl.zeros((BLOCK_N,), tl.int32)\n\n    for j in tl.range(0, N):\n        # ---- variant R: reciprocal scaling --------------------------------\n        cj = tl.sum(tl.where(cols[None, :] == j, wr, 0.0), axis=1)\n        ac = tl.abs(cj)\n        ac = tl.where(rows >= j, ac, -1.0)\n        ac = tl.where(rows < N, ac, -1.0)\n        pv = tl.max(ac, axis=0)\n        jp = tl.min(tl.where(ac == pv, rows, BLOCK_N), axis=0)\n        pvval = tl.sum(tl.where(rows == jp, cj, 0.0), axis=0)\n        rj = tl.sum(tl.where(rows[:, None] == j, wr, 0.0), axis=0)\n        rp = tl.sum(tl.where(rows[:, None] == jp, wr, 0.0), axis=0)\n        wr = tl.where((rows[:, None] == j) & (cols[None, :] < N), rp[None, :], wr)\n        wr = tl.where((rows[:, None] == jp) & (cols[None, :] < N), rj[None, :], wr)\n        rec = tl.where(pvval != 0.0, 1.0 / pvval, 1.0)\n        sm = (rows[:, None] > j) & (cols[None, :] == j)\n        wr = tl.where(sm, wr * rec, wr)\n        sr = tl.where((pvval == 0.0) & (sr == 0), j + 1, sr)\n        xc = tl.sum(tl.where(cols[None, :] == j, wr, 0.0), axis=1)\n        ur = tl.sum(tl.where(rows[:, None] == j, wr, 0.0), axis=0)\n        um = (rows[:, None] > j) & (cols[None, :] > j)\n        if USE_FMA:\n            wr = tl.where(um, tl.math.fma(-xc[:, None], ur[None, :], wr), wr)\n        else:\n            wr = tl.where(um, wr - xc[:, None] * ur[None, :], wr)\n\n        # ---- variant D: per-element division ------------------------------\n        cj2 = tl.sum(tl.where(cols[None, :] == j, wd, 0.0), axis=1)\n        ac2 = tl.abs(cj2)\n        ac2 = tl.where(rows >= j, ac2, -1.0)\n        ac2 = tl.where(rows < N, ac2, -1.0)\n        pv2 = tl.max(ac2, axis=0)\n        jp2 = tl.min(tl.where(ac2 == pv2, rows, BLOCK_N), axis=0)\n        pvv2 = tl.sum(tl.where(rows == jp2, cj2, 0.0), axis=0)\n        rj2 = tl.sum(tl.where(rows[:, None] == j, wd, 0.0), axis=0)\n        rp2 = tl.sum(tl.where(rows[:, None] == jp2, wd, 0.0), axis=0)\n        wd = tl.where((rows[:, None] == j) & (cols[None, :] < N), rp2[None, :], wd)\n        wd = tl.where((rows[:, None] == jp2) & (cols[None, :] < N), rj2[None, :], wd)\n        den = tl.where(pvv2 != 0.0, pvv2, 1.0)\n        wd = tl.where(sm, wd / den, wd)\n        sd = tl.where((pvv2 == 0.0) & (sd == 0), j + 1, sd)\n        xc2 = tl.sum(tl.where(cols[None, :] == j, wd, 0.0), axis=1)\n        ur2 = tl.sum(tl.where(rows[:, None] == j, wd, 0.0), axis=0)\n        wd = tl.where(um, wd - xc2[:, None] * ur2[None, :], wd)\n\n    # store LU diagonals (for emulation comparison)\n    tl.store(LUR + pid * N + rows, tl.sum(tl.where(cols[None, :] == rows[:, None], wr, 0.0), axis=1),\n             mask=rows < N)\n    tl.store(LUD + pid * N + rows, tl.sum(tl.where(cols[None, :] == rows[:, None], wd, 0.0), axis=1),\n             mask=rows < N)\n\n    # ---- solves ----------------------------------------------------------\n    for which in tl.static_range(0, 2):\n        if which == 0:\n            w = wr\n            pr = tl.where(rows < N, tl.sum(tl.where(rows[:, None] == 0, wr, 0.0), axis=0) * 0.0, 0.0)\n        else:\n            w = wd\n        # recompute pivots for this variant\n        pv_buf = pr\n        rhs = tl.where(rows[:, None] == cols[None, :], 1.0, 0.0)\n        # laswp using pivots recomputed by re-running the search on the ORIGINAL matrix\n        for jp3 in tl.range(0, N):\n            # pivot jp3 was stored during factorisation; recompute from the\n            # pivot buffer is not possible here, so use the identity ordering\n            # (pivots are identity for these inputs, verified externally)\n            rhs = rhs\n        for jf in tl.range(0, N):\n            lc = tl.sum(tl.where(cols[None, :] == jf, w, 0.0), axis=1)\n            lc = tl.where(rows > jf, lc, 0.0)\n            rb = tl.sum(tl.where(rows[:, None] == jf, rhs, 0.0), axis=0)\n            rhs = rhs - lc[:, None] * rb[None, :]\n        for jr in tl.range(0, N):\n            jb = N - 1 - jr\n            dc = tl.sum(tl.where(cols[None, :] == jb, w, 0.0), axis=1)\n            dv = tl.sum(tl.where(rows == jb, dc, 0.0), axis=0)\n            rb = tl.sum(tl.where(rows[:, None] == jb, rhs, 0.0), axis=0) / dv\n            rhs = tl.where(rows[:, None] == jb, rb[None, :], rhs)\n            uc = tl.sum(tl.where(cols[None, :] == jb, w, 0.0), axis=1)\n            uc = tl.where(rows < jb, uc, 0.0)\n            rhs = rhs - uc[:, None] * rb[None, :]\n        off = base + cols[None, :] * N + rows[:, None]\n        if which == 0:\n            tl.store(INR + off, rhs, mask=m)\n        else:\n            tl.store(IND + off, rhs, mask=m)\n\n    tl.store(IFR + pid, sr)\n    tl.store(INFI + pid, sd)\n\n\ndef build(spec, seed):\n    n = spec[\"shape\"][-1]\n    g = torch.Generator().manual_seed(seed)\n    _ = torch.randn(spec[\"shape\"], generator=g)\n    x = torch.randn(spec[\"shape\"], generator=g)\n    x = x + torch.eye(n) * (n + 1)\n    if spec.get(\"singular\"):\n        x[..., -1, :] = x[..., 0, :]\n    return x.to(torch.float32).contiguous()\n\n\nreport = {\"has_fma\": hasattr(tl.math, \"fma\")}\nfor name, spec, seed in ((\"c0\", {\"shape\": [3, 3]}, 1729),\n                         (\"c1\", {\"shape\": [3, 3], \"singular\": True}, 1730)):\n    n = 3\n    blk = 4\n    A = build(spec, seed)\n    ref = torch.linalg.inv_ex(A, check_errors=False)\n    An = A.to(\"npu\")\n    outs = {}\n    for tag, use_fma in ((\"mulsubl\", False), (\"fma\", True)):\n        if use_fma and not hasattr(tl.math, \"fma\"):\n            continue\n        inr = torch.empty(1, n, n, dtype=torch.float32, device=\"npu\")\n        ind = torch.empty(1, n, n, dtype=torch.float32, device=\"npu\")\n        ifr = torch.empty(1, dtype=torch.int32, device=\"npu\")\n        infi = torch.empty(1, dtype=torch.int32, device=\"npu\")\n        lur = torch.empty(1, n, dtype=torch.float32, device=\"npu\")\n        lud = torch.empty(1, n, dtype=torch.float32, device=\"npu\")\n        try:\n            with torch_device_fn.device(An.device):\n                dual[(1,)](An, inr, ind, ifr, infi, lur, lud, N=n, BLOCK_N=blk,\n                           USE_FMA=use_fma, num_warps=1)\n            r = ref[0].cpu()\n            for lab, t in ((\"recip\", inr), (\"div\", ind)):\n                v = t.cpu()\n                d = (v.double() - r.double()).abs()\n                outs[f\"{tag}/{lab}\"] = {\n                    \"exact\": int((v.view(torch.int32) == r.view(torch.int32)).sum()),\n                    \"numel\": int(v.numel()),\n                    \"finite\": bool(torch.isfinite(v).all()),\n                    \"max_rel\": float((d / r.double().abs().clamp_min(1e-300)).max()),\n                    \"values\": v.reshape(-1).tolist()[:9],\n                    \"info\": int(ifr.cpu()[0]) if lab == \"recip\" else int(infi.cpu()[0]),\n                }\n            outs[f\"{tag}/lu_diag\"] = lur.cpu().tolist()\n        except Exception as exc:\n            outs[tag] = {\"error\": repr(exc)[:400]}\n        break  # one compilation only; fma variant reported via has_fma\n    report[name] = {\n        \"ref_info\": ref[1].reshape(-1).tolist(),\n        \"ref_values\": ref[0].reshape(-1).tolist()[:9],\n        \"ref_absmax\": float(ref[0].abs().max()),\n        \"results\": outs,\n    }\n\nwith open(os.path.join(OUT, \"probe7.json\"), \"w\") as f:\n    json.dump(report, f, indent=1)\nprint(json.dumps(report, indent=1)[:6000])\n"
