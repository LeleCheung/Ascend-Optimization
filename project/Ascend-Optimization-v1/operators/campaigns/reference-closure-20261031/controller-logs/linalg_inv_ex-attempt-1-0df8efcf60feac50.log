  "content": "\"\"\"Decisive single-compile test of the shippable A^T-route kernel (n=3).\n\nUses index-based transposed access (no tl.trans), rounded-reciprocal scaling,\nplain `work - x*u` updates (this backend gives mul+sub) and the real laswp, then\ncompares against the torch reference on the non-singular and singular 3x3\nworkload inputs: bit-exact count, max relative error, info and values.\n\"\"\"\n\nimport json\nimport os\n\nimport torch\nimport triton\nimport triton.language as tl\nfrom flag_gems.runtime import torch_device_fn\n\nOUT = os.environ.get(\"KGS_DEBUG_ARTIFACTS\", \".\")\n\n\n@triton.jit\ndef invk(A, INV, INFO, PIV, N: tl.constexpr, BLOCK_N: tl.constexpr):\n    pid = tl.program_id(0)\n    rows = tl.arange(0, BLOCK_N)\n    cols = tl.arange(0, BLOCK_N)\n    m = (rows[:, None] < N) & (cols[None, :] < N)\n    base = pid * N * N\n    work = tl.load(A + base + cols[None, :] * N + rows[:, None], mask=m, other=0.0).to(tl.float32)\n    singular = 0\n    for j in tl.range(0, N):\n        cj = tl.sum(tl.where(cols[None, :] == j, work, 0.0), axis=1)\n        ac = tl.abs(cj)\n        ac = tl.where(rows >= j, ac, -1.0)\n        ac = tl.where(rows < N, ac, -1.0)\n        pvv = tl.max(ac, axis=0)\n        jp = tl.min(tl.where(ac == pvv, rows, BLOCK_N), axis=0)\n        tl.store(PIV + pid * N + j, jp)\n        pivot = tl.sum(tl.where(rows == jp, cj, 0.0), axis=0)\n        rj = tl.sum(tl.where(rows[:, None] == j, work, 0.0), axis=0)\n        rp = tl.sum(tl.where(rows[:, None] == jp, work, 0.0), axis=0)\n        work = tl.where((rows[:, None] == j) & (cols[None, :] < N), rp[None, :], work)\n        work = tl.where((rows[:, None] == jp) & (cols[None, :] < N), rj[None, :], work)\n        sm = (rows[:, None] > j) & (cols[None, :] == j)\n        rec = tl.where(pivot != 0.0, 1.0 / pivot, 1.0)\n        work = tl.where(sm, work * rec, work)\n        singular = tl.where((pivot == 0.0) & (singular == 0), j + 1, singular)\n        xc = tl.sum(tl.where(cols[None, :] == j, work, 0.0), axis=1)\n        ur = tl.sum(tl.where(rows[:, None] == j, work, 0.0), axis=0)\n        um = (rows[:, None] > j) & (cols[None, :] > j)\n        work = tl.where(um, work - xc[:, None] * ur[None, :], work)\n\n    rhs = tl.where(rows[:, None] == cols[None, :], 1.0, 0.0)\n    for jp2 in tl.range(0, N):\n        pr = tl.load(PIV + pid * N + jp2)\n        a1 = tl.sum(tl.where(rows[:, None] == jp2, rhs, 0.0), axis=0)\n        a2 = tl.sum(tl.where(rows[:, None] == pr, rhs, 0.0), axis=0)\n        rhs = tl.where(rows[:, None] == jp2, a2[None, :], rhs)\n        rhs = tl.where(rows[:, None] == pr, a1[None, :], rhs)\n    for jf in tl.range(0, N):\n        lc = tl.sum(tl.where(cols[None, :] == jf, work, 0.0), axis=1)\n        lc = tl.where(rows > jf, lc, 0.0)\n        rb = tl.sum(tl.where(rows[:, None] == jf, rhs, 0.0), axis=0)\n        rhs = rhs - lc[:, None] * rb[None, :]\n    for jr in tl.range(0, N):\n        jb = N - 1 - jr\n        dc = tl.sum(tl.where(cols[None, :] == jb, work, 0.0), axis=1)\n        dv = tl.sum(tl.where(rows == jb, dc, 0.0), axis=0)\n        rb = tl.sum(tl.where(rows[:, None] == jb, rhs, 0.0), axis=0) / dv\n        rhs = tl.where(rows[:, None] == jb, rb[None, :], rhs)\n        uc = tl.sum(tl.where(cols[None, :] == jb, work, 0.0), axis=1)\n        uc = tl.where(rows < jb, uc, 0.0)\n        rhs = rhs - uc[:, None] * rb[None, :]\n\n    tl.store(INV + base + cols[None, :] * N + rows[:, None], rhs, mask=m)\n    tl.store(INFO + pid, singular)\n\n\ndef build(spec, seed):\n    n = spec[\"shape\"][-1]\n    g = torch.Generator().manual_seed(seed)\n    _ = torch.randn(spec[\"shape\"], generator=g)\n    x = torch.randn(spec[\"shape\"], generator=g)\n    x = x + torch.eye(n) * (n + 1)\n    if spec.get(\"singular\"):\n        x[..., -1, :] = x[..., 0, :]\n    return x.to(torch.float32).contiguous()\n\n\nreport = {\"has_fma\": hasattr(tl.math, \"fma\")}\nfor name, spec, seed in ((\"c0\", {\"shape\": [3, 3]}, 1729),\n                         (\"c1\", {\"shape\": 