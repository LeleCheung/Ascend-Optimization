import json, os
import numpy as np
import torch

OUT = os.environ.get("KGS_DEBUG_ARTIFACTS", ".")

def build(spec, seed):
    n = spec["shape"][-1]
    g = torch.Generator().manual_seed(seed)
    x = torch.randn(spec["shape"], generator=g)
    x = x + torch.eye(n) * (n + 1)
