  "content": "\"\"\"Run the current candidate (tmp/main.py) on the correctness inputs and dump\nthe actual outputs, to see where the non-finite values come from.\"\"\"\n\nimport importlib.util\nimport json\nimport os\n\nimport torch\n\nOUT = os.environ.get(\"KGS_DEBUG_ARTIFACTS\", \".\")\n\nspec = importlib.util.spec_from_file_location(\"cand\", \"tmp/main.py\")\ncand = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(cand)\n\n\ndef build(s, seed):\n    n = s[\"shape\"][-1]\n    g = torch.Generator().manual_seed(seed)\n    _ = torch.randn(s[\"shape\"], generator=g)\n    x = torch.randn(s[\"shape\"], generator=g)\n    x = x + torch.eye(n) * (n + 1)\n    if s.get(\"singular\"):\n        x[..., -1, :] = x[..., 0, :]\n    return x.to(torch.float32).contiguous()\n\n\nreport = {}\nfor name, s, seed in (\n    (\"c0\", {\"shape\": [3, 3]}, 1729),\n    (\"c1\", {\"shape\": [3, 3], \"singular\": True}, 1730),\n    (\"c2\", {\"shape\": [2, 7, 7]}, 1731),\n    (\"c3\", {\"shape\": [2, 7, 7], \"singular\": True}, 1732),\n    (\"t0\", {\"shape\": [16, 16]}, 1729),\n):\n    A = build(s, seed)\n    ref = torch.linalg.inv_ex(A, check_errors=False)\n    An = A.to(\"npu\")\n    try:\n        got = cand.run(An)\n        inv = got.inverse.cpu()\n        info = got.info.cpu()\n        r = ref[0]\n        d = (inv.double() - r.double()).abs()\n        report[name] = {\n            \"info\": info.reshape(-1).tolist(),\n            \"ref_info\": ref[1].reshape(-1).tolist(),\n            \"finite\": bool(torch.isfinite(inv).all()),\n            \"nan\": int(torch.isnan(inv).sum()),\n            \"inf\": int(torch.isinf(inv).sum()),\n            \"absmax\": float(inv.abs().max()),\n            \"ref_absmax\": float(r.abs().max()),\n            \"max_rel\": float((d / r.double().abs().clamp_min(1e-300)).max()),\n            \"values\": inv.reshape(-1).tolist()[:9],\n            \"ref_values\": r.reshape(-1).tolist()[:9],\n        }\n    except Exception as exc:\n        report[name] = {\"error\": repr(exc)[:600]}\n\nwith open(os.path.join(OUT, \"probe8.json\"), \"w\") as f:\n    json.dump(report, f, indent=1)\nprint(json.dumps(report, indent=1)[:6000])\n"
