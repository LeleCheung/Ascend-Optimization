  "content": "\"\"\"Identify the exact float32 arithmetic of torch CPU linalg_inv_ex.\n\nHypothesis: ATen transposes for column-major LAPACK, i.e. the returned inverse\nis inv(A^T)^T computed with LAPACK getrf/getrs arithmetic.  On the singular\nworkload inputs, rows 0 and -1 of A are identical, so elimination on A cancels\nexactly (U[n-1,n-1] == 0.0, lu_factor_ex info = n), while elimination on A^T\ndoes not cancel exactly -> tiny non-zero pivot -> finite ~1e8 entries and\ninfo = 0, which is what the reference shows.\n\nGrid search over {layout, update rounding, back-substitution rounding} on\nNON-SINGULAR matrices, where bit-exact agreement is testable.\n\"\"\"\n\nimport json\nimport os\n\nimport numpy as np\nimport torch\n\nOUT = os.environ.get(\"KGS_DEBUG_ARTIFACTS\", \".\")\n\n\ndef build(spec, seed):\n    n = spec[\"shape\"][-1]\n    g = torch.Generator().manual_seed(seed)\n    _ = torch.randn(spec[\"shape\"], generator=g)\n    x = torch.randn(spec[\"shape\"], generator=g)\n    x = x + torch.eye(n) * (n + 1)\n    if spec.get(\"singular\"):\n        x[..., -1, :] = x[..., 0, :]\n    return x.to(torch.float32).contiguous()\n\n\ndef upd_fma(m, y, cur):\n    return np.float32(np.float64(cur) - np.float64(m) * np.float64(y))\n\n\ndef upd_mul(m, y, cur):\n    return np.float32(cur - np.float32(m * y))\n\n\nUPD = {\"fma\": upd_fma, \"mul\": upd_mul}\n\n\ndef emu_lu(A, upd):\n    \"\"\"LAPACK dgetf2: reciprocal scaling, dger update.\"\"\"\n    n = A.shape[0]\n    M = np.array(A, dtype=np.float32, copy=True)\n    piv = np.zeros(n, np.int32)\n    for j in range(n):\n        jp = j + int(np.argmax(np.abs(M[j:, j])))\n        piv[j] = jp\n        if M[jp, j] != 0.0:\n            if jp != j:\n                M[[j, jp], :] = M[[jp, j], :]\n            if j < n - 1:\n                rec = np.float32(1.0) / np.float32(M[j, j])\n                M[j + 1:, j] = np.float32(M[j + 1:, j] * rec)\n        for k in range(j + 1, n):\n            y = np.float32(M[j, k])\n            for i in range(j + 1, n):\n                M[i, k] = upd(M[i, j], y, M[i, k])\n    return M, piv\n\n\ndef emu_getrs(LU, piv, upd, back=\"div\"):\n    n = LU.shape[0]\n    X = np.zeros((n, n), np.float32)\n    for k in range(n):\n        b = np.zeros(n, np.float32)\n        b[k] = np.float32(1.0)\n        # laswp\n        for j in range(n):\n            p = int(piv[j])\n            if p != j:\n                b[j], b[p] = b[p], b[j]\n        # forward, unit lower (trsm 'L','L','U','N')\n        for j in range(n):\n            t = np.float32(b[j])\n            if t != 0.0:\n                for i in range(j + 1, n):\n                    b[i] = upd(LU[i, j], t, b[i])\n        # back, upper non-unit\n        for j in range(n - 1, -1, -1):\n            if back == \"div\":\n                t = np.float32(b[j] / LU[j, j])\n            else:\n                t = np.float32(b[j] * (np.float32(1.0) / np.float32(LU[j, j])))\n            b[j] = t\n            if t != 0.0:\n                for i in range(j):\n                    b[i] = upd(LU[i, j], t, b[i])\n        X[:, k] = b\n    return X\n\n\ndef bits_eq(a, b):\n    a = np.ascontiguousarray(np.asarray(a, dtype=np.float32))\n    b = np.ascontiguousarray(np.asarray(b, dtype=np.float32))\n    if a.shape != b.shape:\n        return {\"shape_mismatch\": [list(a.shape), list(b.shape)], \"all_exact\": False}\n    exact = int(np.sum(a.view(np.int32) == b.view(np.int32)))\n    d = np.abs(np.float64(a) - np.float64(b))\n    with np.errstate(invalid=\"ignore\", divide=\"ignore\"):\n        rel = np.where(np.float64(np.abs(b)) > 0, d / np.abs(np.float64(b)), d)\n    return {\"exact\": exact, \"numel\": int(a.size),\n            \"max_rel\": float(np.nanmax(rel)) if a.size else 0.0,\n            \"all_exact\": bool(exact == a.size)}\n\n\n# build a set of non-singular test matrices of several sizes\ntests = []\nfor n, seed0 in ((3, 100), (7, 200), (16, 300)):\n    for r in range(4):\n        tests.append((n, build({\"shape\": [n, n]}, seed0 + r)))\n# the real non-singular workload inputs\ntests.append((3, build({\"shape\": [3, 3]}, 1729)))\ntests.append((7, build({\"shape\": [2, 7, 7]}, 1731).reshape(-1, 7, 7)))\n\nvariants = {}\nfor layout in (\"A\", \"AT\"):\n    for uname, upd in UPD.items():\n        for back in (\"div\", \"recip\"):\n            key = f\"{layout}_{uname}_{back}\"\n            variants[key] = {\"exact_matrices\": 0, \"total\": 0, \"worst_rel\": 0.0, \"detail\": []}\n\nfor n, A in tests:\n    flat = A.reshape(-1, n, n)\n    ref = torch.linalg.inv_ex(A, check_errors=False)[0].reshape(-1, n, n)\n    for b in range(flat.shape[0]):\n        Ab = flat[b].numpy()\n        refb = ref[b].numpy()\n        for key, st in variants.items():\n            layout, uname, back = key.split(\"_\")\n            M = Ab.T.copy() if layout == \"AT\" else Ab\n            LU, piv = emu_lu(M, UPD[uname])\n            X = emu_getrs(LU, piv, UPD[uname], back)\n            if layout == \"AT\":\n                X = X.T.copy()\n            r = bits_eq(X, refb)\n            st[\"total\"] += 1\n            st[\"exact_matrices\"] += int(r[\"all_exact\"])\n            st[\"worst_rel\"] = max(st[\"worst_rel\"], r.get(\"max_rel\", 0.0))\n            st[\"detail\"].append({\"n\": n, \"exact\": r.get(\"exact\"), \"numel\": r.get(\"numel\")})\n\nsummary = {\n    k: {\"exact_matrices\": v[\"exact_matrices\"], \"total\": v[\"total\"],\n        \"worst_rel\": v[\"worst_rel\"],\n        \"detail\": v[\"detail\"][:6]}\n    for k, v in variants.items()\n}\n\n# For the best variant also test the singular inputs\nsing = []\nfor spec, seed in (({\"shape\": [3, 3], \"singular\": True}, 1730),\n                   ({\"shape\": [2, 7, 7], \"singular\": True}, 1732)):\n    n = spec[\"shape\"][-1]\n    A = build(spec, seed)\n    flat = A.reshape(-1, n, n)\n    ref = torch.linalg.inv_ex(A, check_errors=False)[0].reshape(-1, n, n)\n    for b in range(flat.shape[0]):\n        Ab = flat[b].numpy()\n        for layout in (\"A\", \"AT\"):\n 