import numpy as np

def emu_lu(A, use_fma, recip_scale=True):
    # A: np.float32 (n,n), row-major logical
    n = A.shape[0]
    M = A.copy()
    piv = np.zeros(n, dtype=np.int32)
    info = 0
    for j in range(n):
        # idamax over rows j..n-1 of column j
        col = np.abs(M[j:, j])
        i = int(np.argmax(col))  # first occurrence
        jp = j + i
        piv[j] = jp
        if M[jp, j] != 0.0:
            if jp != j:
                M[[j, jp], :] = M[[jp, j], :]
            if j < n-1:
                rec = np.float32(1.0)/M[j,j]
                M[j+1:, j] = M[j+1:, j]*rec
        else:
            info = j+1
        # dger
        for k in range(j+1, n):
            y = M[j,k]
            for i2 in range(j+1, n):
                M[i2,k] = fma_or_not(-M[i2,j], y, M[i2,k]) if use_fma else np.float32(M[i2,k] - np.float32(M[i2,j]*y))
    return M, piv, info
```

