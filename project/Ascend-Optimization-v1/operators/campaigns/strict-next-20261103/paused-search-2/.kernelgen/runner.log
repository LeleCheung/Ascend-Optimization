[claude] 📎 1	"""expm1_ : in-place elementwise ``expm1(A)`` on Ascend, self-contained Triton.
2	
3	Semantics reproduced from the reference:
4	  * ``out = expm1(A)`` is written back into ``A`` storage and ``A`` is returned.
5	  * Input dtype (float16 / bfloat16 / float32) is preserved on the output.
6	  * Strided (non-contiguous) views are read *and* written through their real
7	    element strides so the mutation lands in the right storage slots; the view
8	    object itself is returned unchanged.
9	
10	Value function: ``expm1`` is evaluated in the *input* element type instead of
11	widening to fp32.  The Ascend vector unit retires 2x the lanes per instruction
12	for 16-bit element types, and the kernel is vector-instruction bound, so this
13	is the dominant cost term (measured at 16.7M: fp16 0.121 -> 0.061 ms,
14	bf16 0.122 -> 0.092, fp32 0.114 -> 0.090).  Small |x| uses the 2-term series
15	``x * (1 + x/2)`` (product form, not fma, so expm1(-0.0) stays -0.0; the series
16	branch also carries the sign of zero so no separate zero select is needed).
17	The series threshold absorbs the per-dtype precision budget: the truncation
18	error is ~x^2/6, which is 7.8e-3 at 2^-3 (inside the 1.5% fp16/bf16 contract)
19	and 1.0e-5 at 2^-7 (inside the 1e-4 fp32 contract).
20	
21	Tile shape is per element type because UB has to hold the whole tile plus the
22	fp32 temporaries of the exp path - the fp32 tile costs twice the bytes, and
23	bf16 arithmetic is emulated wider, so only fp16 can afford two 8192 tiles
24	(measured at 16.7M, grid = num_vectorcore): fp16 8192x2 = 0.0608 ms,
25	bf16 8192x1 = 0.0920 ms, fp32 4096x2 = 0.0899 ms.  A mask-free main loop with
26	a masked tail was tried and is slower at every one of those points
27	(fp16 0.0734, bf16 0.0929, fp32 0.1083), so the loop keeps per-tile masks.
28	
29	Launch path: the wrapper resolves the compiled kernel once per (dtype, numel,
30	device) and then launches it through its own compiled launcher (grid + raw
31	stream handle + device pointer), which is the same code path ``JITFunction.run``
32	ends in minus the per-call binder / cache-key / dispatch work.
33	"""
34	
35	import torch
36	import torch_npu
37	import triton
38	import triton.language as tl
39	from triton.runtime import driver as _driver
40	
41	_BLOCK = 4096
42	# (tile elements, tiles per loop iteration) per input dtype, measured on target.
43	_TILES = {
44	    torch.float16: (8192, 2),
45	    torch.bfloat16: (8192, 1),
46	    torch.float32: (4096, 2),
47	}
48	# Below this size one tile per program wins; above it the persistent loop does.
49	_STREAM_MIN = 1 << 22
50	# Strided (gather/scatter) tiles materialise one address vector per element, so
51	# the UB budget forces a much smaller tile than the contiguous path.
52	_BLOCK_STRIDED = 512
53	
54	_RAW_STREAM = getattr(torch_npu._C, '_npu_getCurrentRawStreamNoWait', None)
55	
56	# Small-|x| series threshold per element type (see module docstring).
57	_TINY = {torch.float16: 0.125, torch.bfloat16: 0.125, torch.float32: 0.0078125}
58	
59	
60	@triton.jit
61	def _expm1_value(x, TINY: tl.constexpr):
62	    """expm1 in x's own dtype: series below TINY, exp(x) - 1 above.
63	
64	    For 16-bit inputs the threshold is materialised as a tensor of the input's
65	    own element type.  With a plain Python float constant Triton widens the
66	    comparison operand (``arith.extf f16 -> f32`` then ``cmpf`` on f32), so the
67	    mask is produced at fp32 width even though the series, the exp result and
68	    the select are all 16-bit; on target that promotion chain plus the
69	    cross-width select costs far more than the arithmetic itself.  fp32 already
70	    compares at element width and keeps the plain constant (the tensor form
71	    measured slightly slower there).
72	    """
73	    if x.dtype == tl.float32:
74	        return tl.where(tl.abs(x) < TINY, x * (1.0 + 0.5 * x),
75	                        tl.exp(x) - 1.0)
76	    tiny = tl.full((1,), TINY, x.dtype)
77	    return tl.where(tl.abs(x) < tiny, x * (1.0 + 0.5 * x), tl.exp(x) - 1.0)
78	
79	
80	# ``n`` is deliberately not specialised: the compiled kernel is cached per
81	# element type and must serve every length, including lengths that are not a
82	# multiple of 16 (the divisibility hint would otherwise be baked in and reused
83	# for a size it does not hold for).
84	@triton.jit(do_not_specialize=["n"])
85	def _expm1_flat(a_ptr, n, TINY: tl.constexpr, BLOCK: tl.constexpr):
86	    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
87	    mask = offs < n
88	    x = tl.load(a_ptr + offs, mask=mask, other=0.0)
89	    tl.store(a_ptr + offs, _expm1_value(x, TINY), mask=mask)
90	
91	
92	@triton.jit(do_not_specialize=["n"])
93	def _expm1_streaming1(a_ptr, n, TINY: tl.constexpr, BLOCK: tl.constexpr):
94	    """Persistent loop, one tile per iteration, in place."""
95	    lane = tl.arange(0, BLOCK)
96	    step = tl.num_programs(0) * BLOCK
97	    for start in range(tl.program_id(0) * BLOCK, n, step):
98	        off = start + lane
99	        mask = off < n
100	        x = tl.load(a_ptr + off, mask=mask, other=0.0)
101	        tl.store(a_ptr + off, _expm1_value(x, TINY), mask=mask)
102	
103	
104	@triton.jit(do_not_specialize=["n"])
105	def _expm1_streaming2(a_ptr, n, TINY: tl.constexpr, BLOCK: tl.constexpr):
106	    """Persistent loop, two statically disjoint tiles per iteration, in place."""
107	    lane = tl.arange(0, BLOCK)
108	    step = tl.num_programs(0) * (2 * BLOCK)
109	    for start in range(tl.program_id(0) * (2 * BLOCK), n, step):
110	        off0 = start + lane
111	        off1 = start + BLOCK + lane
112	        m0 = off0 < n
113	        m1 = off1 < n
114	        x0 = tl.load(a_ptr + off0, mask=m0, other=0.0)
115	        x1 = tl.load(a_ptr + off1, mask=m1, other=0.0)
116	        tl.store(a_ptr + off0, _expm1_value(x0, TINY), mask=m0)
117	        tl.store(a_ptr + off1, _expm1_value(x1, TINY), mask=m1)
118	
119	
120	@triton.jit
121	def _expm1_scaled(a_ptr, n, SCALE: tl.constexpr, TINY: tl.constexpr,
122	                  BLOCK: tl.constexpr):
123	    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
124	    mask = offs < n
125	    idx = offs * SCALE
126	    x = tl.load(a_ptr + idx, mask=mask, other=0.0)
127	    tl.store(a_ptr + idx, _expm1_value(x, TINY), mask=mask)
128	
129	
130	@triton.jit
131	def _expm1_nd(a_ptr, n,
132	              s0, s1, s2, s3, s4, s5, s6, s7,
133	              t0, t1, t2, t3, t4, t5, t6, t7,
134	              TINY: tl.constexpr, NDIM: tl.constexpr, BLOCK: tl.constexpr):
135	    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
136	    mask = offs < n
137	    shapes = (s0, s1, s2, s3, s4, s5, s6, s7)
138	    strides = (t0, t1, t2, t3, t4, t5, t6, t7)
139	    rem = offs
140	    off = tl.zeros((BLOCK,), dtype=tl.int32)
141	    for i in tl.static_range(8):
142	        if i < NDIM:
143	            stride = strides[NDIM - 1 - i]
144	            size = shapes[NDIM - 1 - i]
145	            off += (rem % size) * stride
146	            rem = rem // size
147	    x = tl.load(a_ptr + off, mask=mask, other=0.0)
148	    tl.store(a_ptr + off, _expm1_value(x, TINY), mask=mask)
149	
150	
151	# dtype -> (stream_launch, stream_fn, stream_meta, stream_grid, tiny,
152	#           stream_block, flat_launch, flat_fn, flat_meta)
153	# The compiled kernels do not depend on the length, so one entry per element
154	# type serves every call and the per-call work is a single dict lookup.
155	_ENTRIES = {}
156	_VECTOR_CORES = {}
157	
158	
159	if _RAW_STREAM is not None:
160	    # takes exactly one device argument on this runtime; the stream is queried
161	    # on every call, never cached across calls
162	    _stream_of = _RAW_STREAM
163	else:
164	    def _stream_of(device):
165	        return torch.npu.current_stream(device).npu_stream
166	
167	
168	_current_stream = _stream_of
169	
170	
171	def _vector_cores(device_index):
172	    """Physical vector-core count of the running device (0 if unavailable)."""
173	    cores = _VECTOR_CORES.get(device_index)
174	    if cores is None:
175	        cores = 0
176	        try:
177	            props = _driver.active.utils.get_device_properties(device_index)
178	            cores = int(dict(props).get('num_vectorcore', 0) or 0)
179	        except Exception:
180	            cores = 0
181	        _VECTOR_CORES[device_index] = cores
182	    return cores
183	
184	
185	def _entry_from(ck):
186	    launcher = ck.run
187	    debug = (getattr(launcher, 'compile_only', False) or
188	             getattr(launcher, 'enable_msprof_register_tensor', False) or
189	             getattr(launcher.metadata, 'debug_enabled', False) or
190	             getattr(launcher.metadata, 'debug', False))
191	    call = launcher if debug else launcher.launch
192	    return call, ck.function, ck.packed_metadata
193	
194	
195	def _build_entry(A):
196	    """Resolve (and cache) the launch recipe for one element type."""
197	    dtype = A.dtype
198	    tiny = _TINY.get(dtype, 0.125)
199	    n = A.numel()
200	    cores = _vector_cores(A.get_device())
201	    entry = None
202	    if cores > 0:
203	        for block, unroll in (_TILES.get(dtype, (_BLOCK, 2)),):
204	            try:
205	                kernel = (_expm1_streaming2 if unroll == 2
206	                          else _expm1_streaming1)
207	                ck = kernel.warmup(A, n, tiny, BLOCK=block, grid=(1,))
208	                st = _entry_from(ck)
209	                entry = (st[0], st[1], st[2], cores, tiny, block)
210	                break
211	            except Exception:
212	                continue
213	    try:
214	        ck = _expm1_flat.warmup(A, n, tiny, BLOCK=_BLOCK, grid=(1,))
215	        fl = _entry_from(ck)
216	    except Exception:
217	        fl = None
218	    if fl is None:
219	        _ENTRIES[dtype] = None
220	        return None
221	    if entry is None:
222	        # no persistent loop available: route every length through the flat tile
223	        entry = (fl[0], fl[1], fl[2], 0, tiny, _BLOCK)
224	    entry = entry + fl
225	    _ENTRIES[dtype] = entry
226	    return entry
227	
228	
229	def _launch_general(A, n):
230	    """Non-contiguous fallback: real element strides, in place."""
231	    shape = A.shape
232	    stride = A.stride()
233	    dims = []  # (size, stride) inner -> outer
234	    for d in range(len(shape) - 1, -1, -1):
235	        s = shape[d]
236	        if s == 1:
237	            continue
238	        st = stride[d]
239	        if dims and st == dims[-1][0] * dims[-1][1]:
240	            dims[-1] = (dims[-1][0] * s, dims[-1][1])
241	        else:
242	            dims.append((s, st))
243	    dims.reverse()
244	    tiny = _TINY.get(A.dtype, 0.125)
245	    if len(dims) == 1:
246	        _expm1_scaled[((n + _BLOCK_STRIDED - 1) // _BLOCK_STRIDED,)](
247	            A, n, SCALE=dims[0][1], TINY=tiny, BLOCK=_BLOCK_STRIDED)
248	        return
249	    if len(dims) > 8:
250	        raise RuntimeError("expm1_: unsupported tensor rank for strided path")
251	    sizes = [d[0] for d in dims] + [1] * (8 - len(dims))
252	    sts = [d[1] for d in dims] + [0] * (8 - len(dims))
253	    _expm1_nd[((n + _BLOCK_STRIDED - 1) // _BLOCK_STRIDED,)](
254	        A, n, *sizes, *sts, TINY=tiny, NDIM=len(dims), BLOCK=_BLOCK_STRIDED)
255	
256	
257	def run(A):
258	    """In-place expm1(A).
259	
260	    The wrapper is the whole cost for short inputs (a 1024-element call spends
261	    ~7.5-10 us inside the C launcher and a few us in Python against a 10 us
262	    reference whole call), so the hot path holds one dict lookup per element
263	    type, one ``get_device`` and one raw-stream query, and nothing else is
264	    cached across calls: the pointer, the length and the stream are re-read
265	    every time.
266	    """
267	    if not A.is_contiguous():
268	        n = A.numel()
269	        if n:
270	            _launch_general(A, n)
271	        return A
272	    ptr = A.data_ptr()
273	    n = A.numel()
274	    if n == 0:
275	        return A
276	    entry = _ENTRIES.get(A.dtype)
277	    if entry is None:
278	        entry = _build_entry(A)
279	        if entry is None:
280	            _expm1_flat[((n + 4095) >> 12,)](
281	                A, n, TINY=_TINY.get(A.dtype, 0.125), BLOCK=_BLOCK)
282	            return A
283	    if ptr & 15:
284	        entry[6]((n + 4095) >> 12, 1, 1, _stream_of(A.get_device()),
285	                 entry[7], entry[8], None, None, None, ptr, n, entry[4], _BLOCK)
286	        return A
287	    if n > _STREAM_MIN and entry[3]:
288	        entry[0](entry[3], 1, 1, _stream_of(A.get_device()), entry[1],
289	                 entry[2], None, None, None, ptr, n, entry[4], entry[5])
290	    else:
291	        entry[6]((n + 4095) >> 12, 1, 1, _stream_of(A.get_device()),
292	                 entry[7], entry[8], None, None, None, ptr, n, entry[4], _BLOCK)
293	    return A
