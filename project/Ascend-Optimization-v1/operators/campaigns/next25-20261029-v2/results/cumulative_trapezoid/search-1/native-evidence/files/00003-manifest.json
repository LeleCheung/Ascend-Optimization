          "path": "main.py",
          "content": "# Copyright 2026 The FlagOS Contributors.\n#\n# Licensed under the Apache License, Version 2.0 (the \"License\");\n# you may not use this file except in compliance with the License.\n# You may obtain a copy of the License at\n#\n#     http://www.apache.org/licenses/LICENSE-2.0\n#\n# Unless required by applicable law or agreed to in writing, software\n# distributed under the License is distributed on an \"AS IS\" BASIS,\n# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n# See the License for the specific language governing permissions and\n# limitations under the License.\n\n# Generated by KernelGen: https://github.com/flagos-ai/KernelGen\n\nimport logging\n\nimport torch\nimport triton\nimport triton.language as tl\n\nlogger = logging.getLogger(__name__)\n\n\n@triton.jit\ndef _cumtrapz_kernel(\n    y_ptr,\n    out_ptr,\n    N,\n    inner,\n    stride_row_in,\n    stride_row_out,\n    BLOCK: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    o = pid // inner\n    i = pid % inner\n    in_base = o * stride_row_in + i\n    out_base = o * stride_row_out + i\n\n    k = tl.arange(0, BLOCK)\n    mask = k < (N - 1)\n\n    a = tl.load(y_ptr + in_base + k * inner, mask=mask, other=0.0).to(tl.float32)\n    b = tl.load(y_ptr + in_base + (k + 1) * inner, mask=mask, other=0.0).to(tl.float32)\n    t = (a + b) * 0.5\n    cs = tl.cumsum(t, axis=0)\n\n    tl.store(out_ptr + out_base + k * inner, cs, mask=mask)\n\n\ndef cumulative_trapezoid(y, *, dx=1, dim=-1):\n    logger.debug(\"GEMS CUMULATIVE_TRAPEZOID\")\n\n    assert y.dtype in (\n        torch.float16,\n        torch.bfloat16,\n        torch.float32,\n        torch.float64,\n    ), f\"cumulative_trapezoid: unsupported dtype {y.dtype}\"\n\n    ndim = y.dim()\n    d = dim if dim >= 0 else dim + ndim\n\n    sizes = list(y.shape)\n    N = sizes[d]\n\n    outer = 1\n    for s in sizes[:d]:\n        outer *= s\n    inner = 1\n    for s in sizes[d + 1 :]:\n        inner *= s\n\n    out_sizes = list(sizes)\n    out_sizes[d] = max(N - 1, 0)\n    output = torch.empty(out_sizes, dtype=y.dtype, device=y.device)\n\n    if N <= 1 or outer * inner == 0:\n        return output if dx == 1 else output * dx\n\n    yc = y.contiguous()\n\n    stride_row_in = N * inner\n    stride_row_out = (N - 1) * inner\n\n    BLOCK = triton.next_power_of_2(max(N - 1, 1))\n    grid = (outer * inner,)\n\n    _cumtrapz_kernel[grid](\n        yc,\n        output,\n        N,\n        inner,\n        stride_row_in,\n        stride_row_out,\n        BLOCK=BLOCK,\n    )\n\n    if dx != 1:\n        output = output * dx\n    return output\n\n\nrun = cumulative_trapezoid\n"
        }
      ]
