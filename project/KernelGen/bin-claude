#!/bin/bash
set -euo pipefail
export ANTHROPIC_MODEL=deepseek-flash
export CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
eval "$(/data/hanle/ascend-optimization/runtime/kg-controller/venv/bin/python - <<'PY'
import json
import shlex

settings = json.load(open('/proc/1/root/root/.claude/settings.json', encoding='utf-8'))
provider = settings.get('env', {})
for name, source in (('ANTHROPIC_BASE_URL', 'ANTHROPIC_BASE_URL'),
                     ('ANTHROPIC_API_KEY', 'ANTHROPIC_AUTH_TOKEN')):
    value = provider.get(source)
    if not value:
        raise SystemExit(f'missing {source} in host Claude settings')
    print(f'export {name}={shlex.quote(value)}')
print('unset ANTHROPIC_AUTH_TOKEN')
PY
)"
exec /data/hanle/ascend-optimization/runtime/kg-controller/claude-native "$@"
