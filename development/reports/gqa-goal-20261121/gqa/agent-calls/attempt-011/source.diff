+@triton.jit
+def _gqa_v_cast_f16_kernel(
+    V, Vs,
+    v_sb: tl.constexpr, v_ss: tl.constexpr, v_sh: tl.constexpr, v_sd: tl.constexpr,
+    o_sb: tl.constexpr, o_ss: tl.constexpr,
+    SKV: tl.constexpr, C: tl.constexpr, D: tl.constexpr,
+    BLOCK_R: tl.constexpr, BLOCK_C: tl.constexpr,
+):
+    """把原 V (B, SKV, NKV, D) 一次性由 bf16 转成连续 fp16 scratch。
+
+    本轮机制：主 kernel 里 V 的 bf16→f32→f16 转换此前由每个 program 重复
+    执行（同一 KV 头切片被 G 个 query 头 × S/BLOCK_M 个 query 块共用），
+    这里改成每个 V 元素只转一次。grid 三维分别覆盖 (NKV*D 列块, SKV 行块,
+    B)，每个输出元素恰好被一个 program 的一条掩码通道写到；读取按原 V 的
+    真实 stride（行 v_ss、头 v_sh、通道 v_sd），因此非连续输入也能正确取值。
+    写出目标是 host 分配的连续 fp16 缓冲（行 o_ss，批 o_sb）。
+    """
+    pid_c = tl.program_id(0)
+    pid_j = tl.program_id(1)
+    pid_b = tl.program_id(2)
+
+    offs_j = pid_j * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_c = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
+    j_ok = offs_j < SKV
+    c_ok = offs_c < C
+    mask = j_ok[:, None] & c_ok[None, :]
+
+    # C 轴打包了 (NKV, D) 两维：h = offs_c // D、d = offs_c % D。D 是
+    # constexpr，除法/取模在编译期折叠为移位与掩码（D 为 2 的幂时）。
+    src = (V + pid_b * v_sb + offs_j[:, None] * v_ss
+           + (offs_c // D)[None, :] * v_sh + (offs_c % D)[None, :] * v_sd)
+    v = tl.load(src, mask=mask, other=0.0)
+    dst = Vs + pid_b * o_sb + offs_j[:, None] * o_ss + offs_c[None, :]
+    # 与主 kernel 原路径同为 bf16→f32→f16（两次显式舍入），保证每个 V 元素
+    # 的位型与父版本逐元素一致；被掩码的通道不写出。
+    tl.store(dst, v.to(tl.float32).to(tl.float16), mask=mask)
 
 
