+@triton.jit
+def _gqa_v_cast_f16_flat_kernel(V, Vs, N, BLOCK: tl.constexpr):
+    """连续输入快路径：把原 V 展平后一次性 bf16→f32→f16 拷到连续 fp16 scratch。
+
+    本轮机制：原二维打包路径的源地址含 (offs_c//D)*v_sh+(offs_c%D)*v_sd，
+    对 offs_c 非仿射，实际 BCMLIR 把读端降成 16K 次/程序的标量 memref.load。
+    当原 V 连续时，(B,SKV,NKV,D) 的物理展平与连续 scratch 逐元素一一对应，
+    这里直接用一维线性索引，无 div/mod，读端因此可成为连续块搬运。
+    offs 在 program 间互不重叠、program 内 arange 唯一，故每个输出元素恰好
+    由一条掩码通道写一次；只保留 N 边界 mask。
+    """
+    pid = tl.program_id(0)
+    offs = pid * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < N
+    v = tl.load(V + offs, mask=mask, other=0.0)
+    tl.store(Vs + offs, v.to(tl.float32).to(tl.float16), mask=mask)
 
 
