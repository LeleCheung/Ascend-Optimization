+@triton.jit
+def _gqa_v_cast_f16_headmajor_kernel(
+    V, Vs,
+    v_sb: tl.constexpr, v_ss: tl.constexpr, v_sh: tl.constexpr, v_sd: tl.constexpr,
+    SKV: tl.constexpr, D: tl.constexpr, NKV: tl.constexpr,
+    BLOCK_R: tl.constexpr, BLOCK_D: tl.constexpr,
+):
+    """把连续 BSND 原 V 一次性转成每头物理连续的 [B,NKV,SKV,D] fp16 scratch。
+
+    本轮机制：主 kernel 的实际 BCMLIR 把 V 重解释为
+    memref<256x128xf16, strided<[1024,1]>> 再 memref.copy，行跨度 1024 元素
+    意味着同一 KV 头的 256 行被其余头的 128 元素行隔开，每次只能连续搬 256B。
+    这里改为按头集中：program 标量 pid_h = b*NKV + h 只做一次整除/取模，向量轴
+    只有序列行块 offs_j 与通道 offs_d 两个仿射轴，读端没有逐元素 head/div/mod
+    gather；按原 V 真实 stride（批 v_sb、行 v_ss、头 v_sh、通道 v_sd）载入
+    [BLOCK_R, BLOCK_D] 瓦片，唯一写到 head-major 连续 scratch
+    (pid_h*SKV + j)*D + d。每个输出元素恰好由一个 program 的一条通道写一次，
+    掩码只处理尾部边界。
+    """
+    pid_r = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    b = pid_h // NKV
+    h = pid_h % NKV
+
+    offs_j = pid_r * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_d = tl.arange(0, BLOCK_D)
+    mask = (offs_j[:, None] < SKV) & (offs_d[None, :] < D)
+
+    src = (V + b * v_sb + h * v_sh
+           + offs_j[:, None] * v_ss + offs_d[None, :] * v_sd)
+    v = tl.load(src, mask=mask, other=0.0)
+    dst = Vs + pid_h * (SKV * D) + offs_j[:, None] * D + offs_d[None, :]
+    # 与主 kernel 原路径同为 bf16→f32→f16（两次显式舍入），逐元素位型与父版本一致。
+    tl.store(dst, v.to(tl.float32).to(tl.float16), mask=mask)
 
 
