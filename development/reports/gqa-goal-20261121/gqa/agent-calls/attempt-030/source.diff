+@triton.jit
+def _gqa_finish_tile(
+    raw_qk, v16, Out,
+    b, hq, offs_m, offs_d, offs_n,
+    qk_scale: tl.constexpr,
+    SKV: tl.constexpr, S: tl.constexpr, MASK_KV: tl.constexpr,
+    o_sb: tl.constexpr, o_ss: tl.constexpr, o_sh: tl.constexpr, o_sd: tl.constexpr,
+    BLOCK_D: tl.constexpr, D: tl.constexpr, MASK_MD: tl.constexpr,
+):
+    """单个 query tile 的收尾：父版本表达式逐字保留。
+
+    raw_qk 是未乘 scale 的 FP32 QK（tl.dot 的零初值结果）。这里从乘
+    qk_scale 开始，按原顺序执行 FP32 scale、max/safeguard、exp2、sum、
+    单次 FP16 PV、PV 后除法、全掩码行 guard 与 BSND 写出；前瞻分支与
+    奇数尾 tile 都调用它，故两条路径的浮点表达式和相加顺序一致。
+    """
+    qk = raw_qk * qk_scale
+    if MASK_KV:
+        qk = tl.where(offs_n[None, :] < SKV, qk, -float("inf"))
+
+    m_safe = tl.max(qk, 1)
+    m_safe = tl.where(m_safe > -float("inf"), m_safe, 0.0)
+    p = tl.exp2(qk - m_safe[:, None])
+    l_new = tl.sum(p, 1)
+
+    acc = tl.dot(p.to(tl.float16), v16)
+
+    l_safe = tl.where(l_new > 0.0, l_new, 1.0)
+    out = acc / l_safe[:, None]
+    out = tl.where(l_new[:, None] > 0.0, out, 0.0)
+
+    o_ptrs = Out + b * o_sb + hq * o_sh + offs_m[:, None] * o_ss + offs_d[None, :] * o_sd
+    if MASK_MD:
+        tl.store(o_ptrs, out.to(Out.dtype.element_ty),
+                 mask=(offs_m[:, None] < S) & (offs_d[None, :] < D))
+    else:
+        tl.store(o_ptrs, out.to(Out.dtype.element_ty))
 
 
