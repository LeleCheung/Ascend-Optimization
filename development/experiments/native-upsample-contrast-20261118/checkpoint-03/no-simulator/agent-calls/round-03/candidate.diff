+@triton.jit
+def _hrow_2x(ptr_i, base, IW, j, m, BLOCK_OW: tl.constexpr):
+    # Horizontally bilinear-expand one contiguous source row by 2x.
+    # For align_corners=False and an exact 2x factor the source coordinate of
+    # output column w is 0.5*w - 0.25, so the two column classes are fixed
+    # blends of the current element and its left/right neighbour:
+    #   even columns: 0.25*left  + 0.75*cur
+    #   odd  columns: 0.75*cur   + 0.25*right
+    # Every address below is an affine (stride 1) function of the lane index,
+    # so the loads lower to contiguous DMA copies instead of scalar gathers.
+    x = tl.load(ptr_i + base + j, mask=m, other=0.0).to(tl.float32)
+    xr = tl.load(ptr_i + base + j - 1, mask=m & (j >= 1), other=0.0).to(tl.float32)
+    xr = tl.where(j >= 1, xr, x)
+    xl = tl.load(ptr_i + base + j + 1, mask=m & (j < IW - 1), other=0.0).to(tl.float32)
+    xl = tl.where(j < IW - 1, xl, x)
+    xe = 0.25 * xr + 0.75 * x
+    xo = 0.75 * x + 0.25 * xl
+    return tl.reshape(tl.join(xe, xo), (BLOCK_OW,))
+
+
+@triton.jit
+def upsample_bilinear2d_2x_kernel(
+    ptr_o,
+    ptr_i,
+    IW,
+    OH,
+    OW,
+    IH,
+    BLOCK_IW: tl.constexpr,
+    BLOCK_OW: tl.constexpr,
+):
+    # One program produces the two output rows (2*i, 2*i+1) driven by source
+    # row i of a single (n, c) plane.  Vertical weights are the same fixed
+    # 1/4-3/4 blend as the horizontal ones.
+    i = tl.program_id(axis=0)
+    plane = tl.program_id(axis=1)
+
+    j = tl.arange(0, BLOCK_IW)
+    m = j < IW
+    in_base = plane * (IH * IW)
+
+    e_c = _hrow_2x(ptr_i, in_base + i * IW, IW, j, m, BLOCK_OW)
+    e_u = _hrow_2x(ptr_i, in_base + tl.maximum(i - 1, 0) * IW, IW, j, m, BLOCK_OW)
+    e_d = _hrow_2x(ptr_i, in_base + tl.minimum(i + 1, IH - 1) * IW, IW, j, m, BLOCK_OW)
+
+    out_even = 0.25 * e_u + 0.75 * e_c
+    out_odd = 0.75 * e_c + 0.25 * e_d
+
+    ow = tl.arange(0, BLOCK_OW)
+    mo = ow < OW
+    out_base = plane * (OH * OW) + 2 * i * OW
+    tl.store(
+        ptr_o + out_base + ow,
+        out_even.to(ptr_o.dtype.element_ty),
+        mask=mo,
+    )
+    tl.store(
+        ptr_o + out_base + OW + ow,
+        out_odd.to(ptr_o.dtype.element_ty),
+        mask=mo,
+    )
+
