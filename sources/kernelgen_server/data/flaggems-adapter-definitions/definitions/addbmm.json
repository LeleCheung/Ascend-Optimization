{
  "name": "addbmm",
  "description": "Performs a batch matrix-matrix product of matrices in `batch1` and `batch2`,\nwith a reduced add step (sum over batch dimension), and adds `input` to the result.\nFormula: out = beta * input + alpha * (sum_i batch1_i @ batch2_i).",
  "parameters": [
    {
      "name": "bias",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "batch1",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "batch2",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "beta",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 1.0
    },
    {
      "name": "alpha",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 1.0
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [],
    "returns_alias_of": {}
  },
  "api_version": "v6.0"
}
