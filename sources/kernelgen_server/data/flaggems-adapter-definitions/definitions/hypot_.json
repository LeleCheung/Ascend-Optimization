{
  "name": "hypot_",
  "description": "In-place version of hypot. Given the legs of a right triangle, writes its\nhypotenuse into `self`. The shape of `other` must be broadcastable to `self`.",
  "parameters": [
    {
      "name": "self",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "torch.Tensor"
    },
    {
      "name": "other",
      "kind": "positional_or_keyword",
      "required": true
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [
      "self"
    ],
    "returns_alias_of": {
      "out": "self"
    }
  },
  "api_version": "v6.0"
}
