{
  "name": "addbmm_",
  "description": "Inplace variant of addbmm. Performs a batch matrix-matrix product of matrices in\n`batch1` and `batch2`, with a reduced add step, and stores the result in `self`.\nFormula: self = beta * self + alpha * (sum_i batch1_i @ batch2_i).",
  "parameters": [
    {
      "name": "bias",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "batch1",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "batch2",
      "kind": "positional_or_keyword",
      "required": true
    },
    {
      "name": "beta",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 1.0
    },
    {
      "name": "alpha",
      "kind": "positional_or_keyword",
      "required": false,
      "default": 1.0
    }
  ],
  "outputs": [
    "out"
  ],
  "effects": {
    "mutates": [
      "bias"
    ],
    "returns_alias_of": {
      "out": "bias"
    }
  },
  "api_version": "v6.0"
}
