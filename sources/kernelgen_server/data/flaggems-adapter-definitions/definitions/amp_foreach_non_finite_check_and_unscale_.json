      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "torch.Tensor"
    },
    {
      "name": "inv_scale",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "torch.Tensor"
    }
  ],
  "outputs": [],
  "effects": {
    "mutates": [
      "tensors",
      "found_inf"
    ],
    "returns_alias_of": {}
  },
  "api_version": "v6.0"
