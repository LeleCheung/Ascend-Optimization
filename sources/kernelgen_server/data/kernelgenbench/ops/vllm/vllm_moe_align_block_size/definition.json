      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "expert_ids",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "num_tokens_post_pad",
      "kind": "positional_or_keyword",
      "required": true,
      "type_hint": "Tensor"
    },
    {
      "name": "num_experts",
      "kind": "positional_or_keyword",
      "required": true,
