{
  "additionalProperties": false,
  "properties": {
    "allowed_backends": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Backends",
      "type": "array"
    },
    "allowed_hosts": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Hosts",
      "type": "array"
    },
    "authority": {
      "default": "unknown",
      "enum": [
        "official",
        "first_party",
        "community",
        "unknown"
      ],
      "title": "Authority",
      "type": "string"
    },
    "checksum": {
      "default": "",
      "pattern": "^(|sha256:[0-9a-f]{64})$",
      "title": "Checksum",
      "type": "string"
    },
    "content_root": {
      "minLength": 1,
      "title": "Content Root",
      "type": "string"
    },
    "id": {
      "pattern": "^source:[a-z0-9][a-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "manifest_root": {
      "default": "",
      "title": "Manifest Root",
      "type": "string"
    },
    "origin": {
      "minLength": 1,
      "title": "Origin",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "search_mode": {
      "enum": [
        "searchable",
        "static_only"
      ],
      "title": "Search Mode",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "documentation",
        "blog",
        "repository",
        "paper",
        "dataset",
        "internal"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "usage_notes": {
      "default": "",
      "title": "Usage Notes",
      "type": "string"
    },
    "usage_policy": {
      "default": "unknown",
      "enum": [
        "redistributable",
        "restricted",
        "federated_only",
        "unknown"
      ],
      "title": "Usage Policy",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source_type",
    "origin",
    "revision",
    "content_root",
    "license",
    "search_mode",
    "retrieved_at"
  ],
  "title": "SourcePackage",
  "type": "object"
}
