{
  "$defs": {
    "ConceptRelation": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^kg:(reference|method|diagnostic|experience):",
          "title": "Target",
          "type": "string"
        },
        "type": {
          "enum": [
            "requires",
            "addresses",
            "contradicts",
            "supersedes",
            "refines",
            "broader_than",
            "narrower_than",
            "related"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "ConceptRelation",
      "type": "object"
    },
    "NumericsScope": {
      "additionalProperties": false,
      "properties": {
        "accumulation_dtypes": {
          "items": {
            "type": "string"
          },
          "title": "Accumulation Dtypes",
          "type": "array"
        },
        "allow_tf32": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Tf32"
        },
        "exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        },
        "max_abs_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Abs Error"
        },
        "max_rel_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rel Error"
        }
      },
      "title": "NumericsScope",
      "type": "object"
    },
    "ObservationIntent": {
      "additionalProperties": false,
      "properties": {
        "claim_stance": {
          "description": "Direction of this observation relative to the candidate Concept claim: supports agrees with the claim, refutes contradicts it, and illustrates is relevant without directional proof",
          "enum": [
            "supports",
            "refutes",
            "illustrates"
          ],
          "title": "Claim Stance",
          "type": "string"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "round_num": {
          "exclusiveMinimum": 0,
          "title": "Round Num",
          "type": "integer"
        }
      },
      "required": [
        "round_num",
        "claim_stance",
        "rationale"
      ],
      "title": "ObservationIntent",
      "type": "object"
    },
    "OperatorScope": {
      "additionalProperties": false,
      "properties": {
        "dataflow": {
          "items": {
            "type": "string"
          },
          "title": "Dataflow",
          "type": "array"
        },
        "definition_ids": {
          "items": {
            "type": "string"
          },
          "title": "Definition Ids",
          "type": "array"
        },
        "dtypes": {
          "items": {
            "type": "string"
          },
          "title": "Dtypes",
          "type": "array"
        },
        "layouts": {
          "items": {
            "type": "string"
          },
          "title": "Layouts",
          "type": "array"
        },
        "motifs": {
          "items": {
            "type": "string"
          },
          "title": "Motifs",
          "type": "array"
        },
        "op_types": {
          "items": {
            "type": "string"
          },
          "title": "Op Types",
          "type": "array"
        }
      },
      "title": "OperatorScope",
      "type": "object"
    },
    "RetrievalMetadata": {
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "phases": {
          "items": {
            "enum": [
              "initial",
              "post_error",
              "post_evaluation",
              "post_profile",
              "plateau"
            ],
            "type": "string"
          },
          "title": "Phases",
          "type": "array"
        },
        "symptoms": {
          "items": {
            "type": "string"
          },
          "title": "Symptoms",
          "type": "array"
        },
        "tasks": {
          "items": {
            "enum": [
              "constraint_check",
              "architecture_selection",
              "implementation",
              "diagnosis",
              "next_experiment",
              "portability_analysis"
            ],
            "type": "string"
          },
          "title": "Tasks",
          "type": "array"
        },
        "techniques": {
          "items": {
            "type": "string"
          },
          "title": "Techniques",
          "type": "array"
        }
      },
      "title": "RetrievalMetadata",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "numerics": {
          "$ref": "#/$defs/NumericsScope"
        },
        "operator": {
          "$ref": "#/$defs/OperatorScope"
        },
        "target": {
          "$ref": "#/$defs/TargetScope"
        },
        "workloads": {
          "$ref": "#/$defs/WorkloadScope"
        }
      },
      "required": [
        "target"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SoftwareScope": {
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "default": "",
          "title": "Compiler",
          "type": "string"
        },
        "compiler_version": {
          "default": "",
          "title": "Compiler Version",
          "type": "string"
        },
        "driver_version": {
          "default": "",
          "title": "Driver Version",
          "type": "string"
        },
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "language_version": {
          "default": "",
          "title": "Language Version",
          "type": "string"
        },
        "library": {
          "default": "",
          "title": "Library",
          "type": "string"
        },
        "library_version": {
          "default": "",
          "title": "Library Version",
          "type": "string"
        },
        "runtime": {
          "default": "",
          "title": "Runtime",
          "type": "string"
        },
        "runtime_version": {
          "default": "",
          "title": "Runtime Version",
          "type": "string"
        }
      },
      "title": "SoftwareScope",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "resource": {
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "revision": {
          "default": "",
          "title": "Revision",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "resource"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TargetScope": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "default": "",
          "title": "Architecture",
          "type": "string"
        },
        "backend": {
          "default": "",
          "title": "Backend",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "devices": {
          "items": {
            "type": "string"
          },
          "title": "Devices",
          "type": "array"
        },
        "level": {
          "enum": [
            "exact",
            "device",
            "architecture",
            "backend",
            "portable"
          ],
          "title": "Level",
          "type": "string"
        },
        "software": {
          "$ref": "#/$defs/SoftwareScope"
        }
      },
      "required": [
        "level"
      ],
      "title": "TargetScope",
      "type": "object"
    },
    "WorkloadPredicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "not_in"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "title": "WorkloadPredicate",
      "type": "object"
    },
    "WorkloadScope": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "All",
          "type": "array"
        },
        "any": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "Any",
          "type": "array"
        },
        "excludes": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "Excludes",
          "type": "array"
        }
      },
      "title": "WorkloadScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Candidate Id",
      "type": "string"
    },
    "change_reason": {
      "default": "",
      "title": "Change Reason",
      "type": "string"
    },
    "claim_key": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Claim Key",
      "type": "string"
    },
    "created_by": {
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Domains",
      "type": "array"
    },
    "observation_intents": {
      "items": {
        "$ref": "#/$defs/ObservationIntent"
      },
      "title": "Observation Intents",
      "type": "array"
    },
    "proposed_id": {
      "anyOf": [
        {
          "pattern": "^kg:(reference|method|diagnostic|experience):[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Id"
    },
    "proposed_kind": {
      "enum": [
        "reference",
        "method",
        "diagnostic",
        "experience"
      ],
      "title": "Proposed Kind",
      "type": "string"
    },
    "publish_action": {
      "default": "create",
      "enum": [
        "create",
        "update"
      ],
      "title": "Publish Action",
      "type": "string"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/ConceptRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalMetadata"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "target_concept_id": {
      "anyOf": [
        {
          "pattern": "^kg:(reference|method|diagnostic|experience):[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Concept Id"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "proposed_kind",
    "claim_key",
    "title",
    "summary",
    "domains",
    "scope",
    "body",
    "created_by"
  ],
  "title": "CandidateConcept",
  "type": "object"
}
