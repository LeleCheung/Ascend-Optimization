{
  "$defs": {
    "KnowledgeApplication": {
      "additionalProperties": false,
      "description": "One plan declaration frozen with its measured Observation.",
      "properties": {
        "affected_parts": {
          "items": {
            "type": "string"
          },
          "title": "Affected Parts",
          "type": "array"
        },
        "agent_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnowledgeApplicationAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "application_note": {
          "default": "",
          "maxLength": 2000,
          "title": "Application Note",
          "type": "string"
        },
        "concept_ref": {
          "default": "",
          "pattern": "^(kg:(reference|method|diagnostic|experience):[a-z0-9][a-z0-9._-]*)?$",
          "title": "Concept Ref",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "adopted",
            "adapted",
            "rejected"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "lineage_status": {
          "default": "legacy_unknown",
          "enum": [
            "complete",
            "query_missing",
            "detail_not_read",
            "legacy_unknown"
          ],
          "title": "Lineage Status",
          "type": "string"
        },
        "query_event_id": {
          "default": "",
          "pattern": "^((query|source-query):[A-Za-z0-9._:-]+)?$",
          "title": "Query Event Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "constraint",
            "hypothesis",
            "implementation",
            "diagnostic"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceApplicationReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "role",
        "disposition"
      ],
      "title": "KnowledgeApplication",
      "type": "object"
    },
    "KnowledgeApplicationAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "enum": [
            "confirmed",
            "partially_confirmed",
            "not_confirmed",
            "inconclusive"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "assessment",
        "rationale"
      ],
      "title": "KnowledgeApplicationAssessment",
      "type": "object"
    },
    "KnowledgeUsageScope": {
      "additionalProperties": false,
      "description": "Exact measured scope used for feedback ranking.",
      "properties": {
        "definition_id": {
          "minLength": 1,
          "title": "Definition Id",
          "type": "string"
        },
        "software": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Software",
          "type": "object"
        },
        "target_architecture": {
          "default": "",
          "title": "Target Architecture",
          "type": "string"
        },
        "target_backend": {
          "minLength": 1,
          "title": "Target Backend",
          "type": "string"
        },
        "target_device": {
          "minLength": 1,
          "title": "Target Device",
          "type": "string"
        },
        "workload_features": {
          "additionalProperties": true,
          "title": "Workload Features",
          "type": "object"
        }
      },
      "required": [
        "definition_id",
        "target_backend",
        "target_device"
      ],
      "title": "KnowledgeUsageScope",
      "type": "object"
    },
    "ObservationComparison": {
      "additionalProperties": false,
      "properties": {
        "geo_mean_delta_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geo Mean Delta Pct"
        },
        "performance_baseline_round_num": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Performance Baseline Round Num"
        }
      },
      "title": "ObservationComparison",
      "type": "object"
    },
    "ObservationLocator": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "round_num": {
          "exclusiveMinimum": 0,
          "title": "Round Num",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "round_num"
      ],
      "title": "ObservationLocator",
      "type": "object"
    },
    "ObservationOutcome": {
      "additionalProperties": false,
      "properties": {
        "geo_mean_speedup": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geo Mean Speedup"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "workload_results_ref": {
          "minLength": 1,
          "title": "Workload Results Ref",
          "type": "string"
        }
      },
      "required": [
        "status",
        "workload_results_ref"
      ],
      "title": "ObservationOutcome",
      "type": "object"
    },
    "ObservationParent": {
      "additionalProperties": false,
      "properties": {
        "round_num": {
          "exclusiveMinimum": 0,
          "title": "Round Num",
          "type": "integer"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "round_num",
        "status"
      ],
      "title": "ObservationParent",
      "type": "object"
    },
    "SourceApplicationReference": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "resource": {
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "resource",
        "revision",
        "locator"
      ],
      "title": "SourceApplicationReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A frozen, claim-independent fact materialized from one measured round.",
  "properties": {
    "agent_conclusion": {
      "additionalProperties": true,
      "title": "Agent Conclusion",
      "type": "object"
    },
    "applications": {
      "items": {
        "$ref": "#/$defs/KnowledgeApplication"
      },
      "title": "Applications",
      "type": "array"
    },
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "code_changes": {
      "title": "Code Changes",
      "type": "string"
    },
    "comparison": {
      "$ref": "#/$defs/ObservationComparison"
    },
    "definition_id": {
      "minLength": 1,
      "title": "Definition Id",
      "type": "string"
    },
    "evaluated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluated At"
    },
    "evaluation_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeUsageScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "experiment_parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservationParent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "experiment_plan": {
      "additionalProperties": true,
      "title": "Experiment Plan",
      "type": "object"
    },
    "id": {
      "pattern": "^kg:observation:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+:round-[1-9][0-9]*$",
      "title": "Id",
      "type": "string"
    },
    "ledger_locator": {
      "$ref": "#/$defs/ObservationLocator"
    },
    "operator_signature_ref": {
      "minLength": 1,
      "title": "Operator Signature Ref",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/ObservationOutcome"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "round_num": {
      "exclusiveMinimum": 0,
      "title": "Round Num",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "solution_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Solution Sha256",
      "type": "string"
    },
    "target_context_ref": {
      "minLength": 1,
      "title": "Target Context Ref",
      "type": "string"
    },
    "usage_mode": {
      "default": "none",
      "enum": [
        "none",
        "single",
        "combined"
      ],
      "title": "Usage Mode",
      "type": "string"
    },
    "workspace_id": {
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "run_id",
    "workspace_id",
    "definition_id",
    "round_num",
    "target_context_ref",
    "operator_signature_ref",
    "ledger_locator",
    "solution_sha256",
    "outcome",
    "experiment_plan",
    "code_changes",
    "agent_conclusion",
    "recorded_at"
  ],
  "title": "ObservationRecord",
  "type": "object"
}
