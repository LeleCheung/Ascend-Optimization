{
  "$defs": {
    "BundleCoverage": {
      "additionalProperties": false,
      "properties": {
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "matched_routes": {
          "items": {
            "type": "string"
          },
          "title": "Matched Routes",
          "type": "array"
        }
      },
      "title": "BundleCoverage",
      "type": "object"
    },
    "KnowledgeResult": {
      "additionalProperties": false,
      "properties": {
        "concept_ref": {
          "pattern": "^kg:(reference|method|diagnostic|experience):[a-z0-9][a-z0-9._-]*$",
          "title": "Concept Ref",
          "type": "string"
        },
        "evidence_state": {
          "enum": [
            "source_supported",
            "observed",
            "corroborated",
            "contested",
            "falsified"
          ],
          "title": "Evidence State",
          "type": "string"
        },
        "kind": {
          "enum": [
            "reference",
            "method",
            "diagnostic",
            "experience"
          ],
          "title": "Kind",
          "type": "string"
        },
        "matched_on": {
          "items": {
            "type": "string"
          },
          "title": "Matched On",
          "type": "array"
        },
        "recommendation_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Recommendation Reasons",
          "type": "array"
        },
        "scope_gaps": {
          "items": {
            "type": "string"
          },
          "title": "Scope Gaps",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "usage_summary": {
          "$ref": "#/$defs/KnowledgeUsageSummary"
        }
      },
      "required": [
        "concept_ref",
        "kind",
        "summary",
        "evidence_state"
      ],
      "title": "KnowledgeResult",
      "type": "object"
    },
    "KnowledgeUsageSummary": {
      "additionalProperties": false,
      "description": "Rebuildable same-scope usage facts for one Concept or Source ref.",
      "properties": {
        "agent_confirmed_count": {
          "default": 0,
          "minimum": 0,
          "title": "Agent Confirmed Count",
          "type": "integer"
        },
        "agent_inconclusive_count": {
          "default": 0,
          "minimum": 0,
          "title": "Agent Inconclusive Count",
          "type": "integer"
        },
        "agent_not_confirmed_count": {
          "default": 0,
          "minimum": 0,
          "title": "Agent Not Confirmed Count",
          "type": "integer"
        },
        "agent_partially_confirmed_count": {
          "default": 0,
          "minimum": 0,
          "title": "Agent Partially Confirmed Count",
          "type": "integer"
        },
        "applied_count": {
          "default": 0,
          "minimum": 0,
          "title": "Applied Count",
          "type": "integer"
        },
        "combined_success_count": {
          "default": 0,
          "minimum": 0,
          "title": "Combined Success Count",
          "type": "integer"
        },
        "considered_count": {
          "default": 0,
          "minimum": 0,
          "title": "Considered Count",
          "type": "integer"
        },
        "correctness_recovery_count": {
          "default": 0,
          "minimum": 0,
          "title": "Correctness Recovery Count",
          "type": "integer"
        },
        "evaluated_count": {
          "default": 0,
          "minimum": 0,
          "title": "Evaluated Count",
          "type": "integer"
        },
        "last_used_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Used At"
        },
        "observation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Observation Refs",
          "type": "array"
        },
        "regression_count": {
          "default": 0,
          "minimum": 0,
          "title": "Regression Count",
          "type": "integer"
        },
        "retrieved_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retrieved Count",
          "type": "integer"
        },
        "single_success_count": {
          "default": 0,
          "minimum": 0,
          "title": "Single Success Count",
          "type": "integer"
        }
      },
      "title": "KnowledgeUsageSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analogies": {
      "items": {
        "$ref": "#/$defs/KnowledgeResult"
      },
      "title": "Analogies",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/KnowledgeResult"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/BundleCoverage"
    },
    "direct": {
      "items": {
        "$ref": "#/$defs/KnowledgeResult"
      },
      "title": "Direct",
      "type": "array"
    },
    "query_id": {
      "pattern": "^query:[A-Za-z0-9._:-]+$",
      "title": "Query Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot",
      "type": "string"
    }
  },
  "required": [
    "query_id",
    "snapshot"
  ],
  "title": "KnowledgeBundle",
  "type": "object"
}
