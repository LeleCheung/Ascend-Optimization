{
  "$defs": {
    "GitSourceEntry": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "100644",
            "100755",
            "120000",
            "160000"
          ],
          "title": "Mode",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "enum": [
            "blob",
            "commit"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "pattern": "^(|sha256:[0-9a-f]{64})$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        }
      },
      "required": [
        "path",
        "mode",
        "object_type",
        "object_id"
      ],
      "title": "GitSourceEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/GitSourceEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "object_format": {
      "enum": [
        "sha1",
        "sha256"
      ],
      "title": "Object Format",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_package": {
      "pattern": "^source:[a-z0-9][a-z0-9._-]*$",
      "title": "Source Package",
      "type": "string"
    }
  },
  "required": [
    "source_package",
    "revision",
    "object_format",
    "entries"
  ],
  "title": "GitSourceManifest",
  "type": "object"
}
