{
  "$defs": {
    "ConceptRelation": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^kg:(reference|method|diagnostic|experience):",
          "title": "Target",
          "type": "string"
        },
        "type": {
          "enum": [
            "requires",
            "addresses",
            "contradicts",
            "supersedes",
            "refines",
            "broader_than",
            "narrower_than",
            "related"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "ConceptRelation",
      "type": "object"
    },
    "NumericsScope": {
      "additionalProperties": false,
      "properties": {
        "accumulation_dtypes": {
          "items": {
            "type": "string"
          },
          "title": "Accumulation Dtypes",
          "type": "array"
        },
        "allow_tf32": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Tf32"
        },
        "exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        },
        "max_abs_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Abs Error"
        },
        "max_rel_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rel Error"
        }
      },
      "title": "NumericsScope",
      "type": "object"
    },
    "OperatorScope": {
      "additionalProperties": false,
      "properties": {
        "dataflow": {
          "items": {
            "type": "string"
          },
          "title": "Dataflow",
          "type": "array"
        },
        "definition_ids": {
          "items": {
            "type": "string"
          },
          "title": "Definition Ids",
          "type": "array"
        },
        "dtypes": {
          "items": {
            "type": "string"
          },
          "title": "Dtypes",
          "type": "array"
        },
        "layouts": {
          "items": {
            "type": "string"
          },
          "title": "Layouts",
          "type": "array"
        },
        "motifs": {
          "items": {
            "type": "string"
          },
          "title": "Motifs",
          "type": "array"
        },
        "op_types": {
          "items": {
            "type": "string"
          },
          "title": "Op Types",
          "type": "array"
        }
      },
      "title": "OperatorScope",
      "type": "object"
    },
    "RetrievalMetadata": {
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "phases": {
          "items": {
            "enum": [
              "initial",
              "post_error",
              "post_evaluation",
              "post_profile",
              "plateau"
            ],
            "type": "string"
          },
          "title": "Phases",
          "type": "array"
        },
        "symptoms": {
          "items": {
            "type": "string"
          },
          "title": "Symptoms",
          "type": "array"
        },
        "tasks": {
          "items": {
            "enum": [
              "constraint_check",
              "architecture_selection",
              "implementation",
              "diagnosis",
              "next_experiment",
              "portability_analysis"
            ],
            "type": "string"
          },
          "title": "Tasks",
          "type": "array"
        },
        "techniques": {
          "items": {
            "type": "string"
          },
          "title": "Techniques",
          "type": "array"
        }
      },
      "title": "RetrievalMetadata",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "numerics": {
          "$ref": "#/$defs/NumericsScope"
        },
        "operator": {
          "$ref": "#/$defs/OperatorScope"
        },
        "target": {
          "$ref": "#/$defs/TargetScope"
        },
        "workloads": {
          "$ref": "#/$defs/WorkloadScope"
        }
      },
      "required": [
        "target"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SoftwareScope": {
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "default": "",
          "title": "Compiler",
          "type": "string"
        },
        "compiler_version": {
          "default": "",
          "title": "Compiler Version",
          "type": "string"
        },
        "driver_version": {
          "default": "",
          "title": "Driver Version",
          "type": "string"
        },
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "language_version": {
          "default": "",
          "title": "Language Version",
          "type": "string"
        },
        "library": {
          "default": "",
          "title": "Library",
          "type": "string"
        },
        "library_version": {
          "default": "",
          "title": "Library Version",
          "type": "string"
        },
        "runtime": {
          "default": "",
          "title": "Runtime",
          "type": "string"
        },
        "runtime_version": {
          "default": "",
          "title": "Runtime Version",
          "type": "string"
        }
      },
      "title": "SoftwareScope",
      "type": "object"
    },
    "SourceSelectionRule": {
      "additionalProperties": false,
      "properties": {
        "include": {
          "minLength": 1,
          "title": "Include",
          "type": "string"
        },
        "kinds": {
          "items": {
            "enum": [
              "reference",
              "method",
              "diagnostic",
              "experience"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "mode": {
          "enum": [
            "source_only",
            "indexed",
            "direct",
            "extract",
            "federated"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "include",
        "mode"
      ],
      "title": "SourceSelectionRule",
      "type": "object"
    },
    "StaticKnowledgeEntry": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "default": "",
          "title": "Body",
          "type": "string"
        },
        "claim_key": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Claim Key",
          "type": "string"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        },
        "heading": {
          "default": "",
          "title": "Heading",
          "type": "string"
        },
        "mode": {
          "enum": [
            "direct",
            "extract"
          ],
          "title": "Mode",
          "type": "string"
        },
        "proposed_id": {
          "anyOf": [
            {
              "pattern": "^kg:(reference|method|diagnostic):[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Id"
        },
        "proposed_kind": {
          "enum": [
            "reference",
            "method",
            "diagnostic"
          ],
          "title": "Proposed Kind",
          "type": "string"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/ConceptRelation"
          },
          "title": "Relations",
          "type": "array"
        },
        "retrieval": {
          "$ref": "#/$defs/RetrievalMetadata"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "mode",
        "proposed_kind",
        "claim_key",
        "title",
        "summary",
        "domains",
        "scope"
      ],
      "title": "StaticKnowledgeEntry",
      "type": "object"
    },
    "TargetScope": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "default": "",
          "title": "Architecture",
          "type": "string"
        },
        "backend": {
          "default": "",
          "title": "Backend",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "devices": {
          "items": {
            "type": "string"
          },
          "title": "Devices",
          "type": "array"
        },
        "level": {
          "enum": [
            "exact",
            "device",
            "architecture",
            "backend",
            "portable"
          ],
          "title": "Level",
          "type": "string"
        },
        "software": {
          "$ref": "#/$defs/SoftwareScope"
        }
      },
      "required": [
        "level"
      ],
      "title": "TargetScope",
      "type": "object"
    },
    "WorkloadPredicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "not_in"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "title": "WorkloadPredicate",
      "type": "object"
    },
    "WorkloadScope": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "All",
          "type": "array"
        },
        "any": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "Any",
          "type": "array"
        },
        "excludes": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "Excludes",
          "type": "array"
        }
      },
      "title": "WorkloadScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/StaticKnowledgeEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/SourceSelectionRule"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_package": {
      "pattern": "^source:[a-z0-9][a-z0-9._-]*$",
      "title": "Source Package",
      "type": "string"
    }
  },
  "required": [
    "source_package",
    "rules"
  ],
  "title": "StaticIngestionPlan",
  "type": "object"
}
