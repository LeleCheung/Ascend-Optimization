{
  "$defs": {
    "ConceptEvidence": {
      "additionalProperties": false,
      "description": "Why one immutable Observation is evidence for this Concept.",
      "properties": {
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "observation_ref": {
          "pattern": "^kg:observation:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+:round-[1-9][0-9]*$",
          "title": "Observation Ref",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "stance": {
          "enum": [
            "supports",
            "refutes",
            "illustrates"
          ],
          "title": "Stance",
          "type": "string"
        }
      },
      "required": [
        "observation_ref",
        "stance",
        "rationale"
      ],
      "title": "ConceptEvidence",
      "type": "object"
    },
    "ConceptRelation": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^kg:(reference|method|diagnostic|experience):",
          "title": "Target",
          "type": "string"
        },
        "type": {
          "enum": [
            "requires",
            "addresses",
            "contradicts",
            "supersedes",
            "refines",
            "broader_than",
            "narrower_than",
            "related"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "ConceptRelation",
      "type": "object"
    },
    "ManagedMetadata": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "content_hash",
        "created_by",
        "created_at",
        "updated_at"
      ],
      "title": "ManagedMetadata",
      "type": "object"
    },
    "NumericsScope": {
      "additionalProperties": false,
      "properties": {
        "accumulation_dtypes": {
          "items": {
            "type": "string"
          },
          "title": "Accumulation Dtypes",
          "type": "array"
        },
        "allow_tf32": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Tf32"
        },
        "exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        },
        "max_abs_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Abs Error"
        },
        "max_rel_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rel Error"
        }
      },
      "title": "NumericsScope",
      "type": "object"
    },
    "OperatorScope": {
      "additionalProperties": false,
      "properties": {
        "dataflow": {
          "items": {
            "type": "string"
          },
          "title": "Dataflow",
          "type": "array"
        },
        "definition_ids": {
          "items": {
            "type": "string"
          },
          "title": "Definition Ids",
          "type": "array"
        },
        "dtypes": {
          "items": {
            "type": "string"
          },
          "title": "Dtypes",
          "type": "array"
        },
        "layouts": {
          "items": {
            "type": "string"
          },
          "title": "Layouts",
          "type": "array"
        },
        "motifs": {
          "items": {
            "type": "string"
          },
          "title": "Motifs",
          "type": "array"
        },
        "op_types": {
          "items": {
            "type": "string"
          },
          "title": "Op Types",
          "type": "array"
        }
      },
      "title": "OperatorScope",
      "type": "object"
    },
    "RetrievalMetadata": {
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "phases": {
          "items": {
            "enum": [
              "initial",
              "post_error",
              "post_evaluation",
              "post_profile",
              "plateau"
            ],
            "type": "string"
          },
          "title": "Phases",
          "type": "array"
        },
        "symptoms": {
          "items": {
            "type": "string"
          },
          "title": "Symptoms",
          "type": "array"
        },
        "tasks": {
          "items": {
            "enum": [
              "constraint_check",
              "architecture_selection",
              "implementation",
              "diagnosis",
              "next_experiment",
              "portability_analysis"
            ],
            "type": "string"
          },
          "title": "Tasks",
          "type": "array"
        },
        "techniques": {
          "items": {
            "type": "string"
          },
          "title": "Techniques",
          "type": "array"
        }
      },
      "title": "RetrievalMetadata",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "numerics": {
          "$ref": "#/$defs/NumericsScope"
        },
        "operator": {
          "$ref": "#/$defs/OperatorScope"
        },
        "target": {
          "$ref": "#/$defs/TargetScope"
        },
        "workloads": {
          "$ref": "#/$defs/WorkloadScope"
        }
      },
      "required": [
        "target"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SoftwareScope": {
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "default": "",
          "title": "Compiler",
          "type": "string"
        },
        "compiler_version": {
          "default": "",
          "title": "Compiler Version",
          "type": "string"
        },
        "driver_version": {
          "default": "",
          "title": "Driver Version",
          "type": "string"
        },
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "language_version": {
          "default": "",
          "title": "Language Version",
          "type": "string"
        },
        "library": {
          "default": "",
          "title": "Library",
          "type": "string"
        },
        "library_version": {
          "default": "",
          "title": "Library Version",
          "type": "string"
        },
        "runtime": {
          "default": "",
          "title": "Runtime",
          "type": "string"
        },
        "runtime_version": {
          "default": "",
          "title": "Runtime Version",
          "type": "string"
        }
      },
      "title": "SoftwareScope",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "resource": {
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "revision": {
          "default": "",
          "title": "Revision",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "resource"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TargetScope": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "default": "",
          "title": "Architecture",
          "type": "string"
        },
        "backend": {
          "default": "",
          "title": "Backend",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "devices": {
          "items": {
            "type": "string"
          },
          "title": "Devices",
          "type": "array"
        },
        "level": {
          "enum": [
            "exact",
            "device",
            "architecture",
            "backend",
            "portable"
          ],
          "title": "Level",
          "type": "string"
        },
        "software": {
          "$ref": "#/$defs/SoftwareScope"
        }
      },
      "required": [
        "level"
      ],
      "title": "TargetScope",
      "type": "object"
    },
    "VerificationInfo": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "by": {
          "minLength": 1,
          "title": "By",
          "type": "string"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "title": "VerificationInfo",
      "type": "object"
    },
    "WorkloadPredicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "not_in"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "title": "WorkloadPredicate",
      "type": "object"
    },
    "WorkloadScope": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "All",
          "type": "array"
        },
        "any": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "Any",
          "type": "array"
        },
        "excludes": {
          "items": {
            "$ref": "#/$defs/WorkloadPredicate"
          },
          "title": "Excludes",
          "type": "array"
        }
      },
      "title": "WorkloadScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "claim_key": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Claim Key",
      "type": "string"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Domains",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ConceptEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_state": {
      "enum": [
        "source_supported",
        "observed",
        "corroborated",
        "contested",
        "falsified"
      ],
      "title": "Evidence State",
      "type": "string"
    },
    "id": {
      "pattern": "^kg:(reference|method|diagnostic|experience):[a-z0-9][a-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "reference",
        "method",
        "diagnostic",
        "experience"
      ],
      "title": "Kind",
      "type": "string"
    },
    "managed": {
      "$ref": "#/$defs/ManagedMetadata"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/ConceptRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalMetadata"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "stale_after": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stale After"
    },
    "status": {
      "default": "stable",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "verified": {
      "items": {
        "$ref": "#/$defs/VerificationInfo"
      },
      "title": "Verified",
      "type": "array"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "summary",
    "claim_key",
    "domains",
    "scope",
    "evidence_state",
    "managed",
    "body"
  ],
  "title": "Concept",
  "type": "object"
}
