{
  "$defs": {
    "NumericsScope": {
      "additionalProperties": false,
      "properties": {
        "accumulation_dtypes": {
          "items": {
            "type": "string"
          },
          "title": "Accumulation Dtypes",
          "type": "array"
        },
        "allow_tf32": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Tf32"
        },
        "exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        },
        "max_abs_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Abs Error"
        },
        "max_rel_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rel Error"
        }
      },
      "title": "NumericsScope",
      "type": "object"
    },
    "OperatorSignature": {
      "additionalProperties": false,
      "properties": {
        "dataflow": {
          "items": {
            "type": "string"
          },
          "title": "Dataflow",
          "type": "array"
        },
        "definition_id": {
          "minLength": 1,
          "title": "Definition Id",
          "type": "string"
        },
        "definition_name": {
          "minLength": 1,
          "title": "Definition Name",
          "type": "string"
        },
        "dtypes": {
          "items": {
            "type": "string"
          },
          "title": "Dtypes",
          "type": "array"
        },
        "layouts": {
          "items": {
            "type": "string"
          },
          "title": "Layouts",
          "type": "array"
        },
        "motifs": {
          "items": {
            "type": "string"
          },
          "title": "Motifs",
          "type": "array"
        },
        "numerics": {
          "$ref": "#/$defs/NumericsScope"
        },
        "op_type": {
          "default": "",
          "title": "Op Type",
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workload_features": {
          "additionalProperties": true,
          "title": "Workload Features",
          "type": "object"
        }
      },
      "required": [
        "definition_id",
        "definition_name"
      ],
      "title": "OperatorSignature",
      "type": "object"
    },
    "ProfileFindingContext": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "workload_uuids": {
          "items": {
            "type": "string"
          },
          "title": "Workload Uuids",
          "type": "array"
        }
      },
      "required": [
        "category",
        "label",
        "confidence"
      ],
      "title": "ProfileFindingContext",
      "type": "object"
    },
    "SoftwareContext": {
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "default": "",
          "title": "Compiler",
          "type": "string"
        },
        "compiler_version": {
          "default": "",
          "title": "Compiler Version",
          "type": "string"
        },
        "driver_version": {
          "default": "",
          "title": "Driver Version",
          "type": "string"
        },
        "language": {
          "default": "",
          "title": "Language",
          "type": "string"
        },
        "language_version": {
          "default": "",
          "title": "Language Version",
          "type": "string"
        },
        "library": {
          "default": "",
          "title": "Library",
          "type": "string"
        },
        "library_version": {
          "default": "",
          "title": "Library Version",
          "type": "string"
        },
        "runtime": {
          "default": "",
          "title": "Runtime",
          "type": "string"
        },
        "runtime_version": {
          "default": "",
          "title": "Runtime Version",
          "type": "string"
        }
      },
      "title": "SoftwareContext",
      "type": "object"
    },
    "TargetContext": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "default": "",
          "title": "Architecture",
          "type": "string"
        },
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "device": {
          "minLength": 1,
          "title": "Device",
          "type": "string"
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "software": {
          "$ref": "#/$defs/SoftwareContext"
        },
        "source": {
          "enum": [
            "eval_service",
            "profile_service",
            "orchestrator",
            "fixture"
          ],
          "title": "Source",
          "type": "string"
        },
        "vendor": {
          "default": "",
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "device",
        "source"
      ],
      "title": "TargetContext",
      "type": "object"
    },
    "TargetMetadata": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "default": false,
          "title": "Complete",
          "type": "boolean"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        }
      },
      "title": "TargetMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ProfileFindingContext"
      },
      "title": "Findings",
      "type": "array"
    },
    "max_results": {
      "default": 12,
      "maximum": 100,
      "minimum": 1,
      "title": "Max Results",
      "type": "integer"
    },
    "operator_signature": {
      "$ref": "#/$defs/OperatorSignature"
    },
    "phase": {
      "enum": [
        "initial",
        "post_error",
        "post_evaluation",
        "post_profile",
        "plateau"
      ],
      "title": "Phase",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "round_num": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Round Num"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_context": {
      "$ref": "#/$defs/TargetContext"
    },
    "task": {
      "enum": [
        "constraint_check",
        "architecture_selection",
        "implementation",
        "diagnosis",
        "next_experiment",
        "portability_analysis"
      ],
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "phase",
    "task",
    "question",
    "operator_signature",
    "target_context"
  ],
  "title": "QueryContext",
  "type": "object"
}
