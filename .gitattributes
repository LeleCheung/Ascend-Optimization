*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.whl filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
/benchmarks/regressions/**/*.so filter=lfs diff=lfs merge=lfs -text
/benchmarks/regressions/**/*.npubin filter=lfs diff=lfs merge=lfs -text

.gitattributes text eol=lf
.gitignore text eol=lf
README.md text eol=lf
/AGENTS.md text eol=lf
pyproject.toml text eol=lf
/src/** text eol=lf
/skills/** text eol=lf
/tools/** text eol=lf
/tests/** text eol=lf
/schemas/** text eol=lf
/docs/** text eol=lf
/manifests/** text eol=lf
/benchmarks/index.json text eol=lf
/benchmarks/current.json text eol=lf

# 固定的 FlagGems 上游快照保持原始字节，清单可在 Windows/Linux 核验。
third_party/FlagGems/** -text !eol

# 精选原始证据和冻结候选保留字节身份。
/examples/** -text !eol
/benchmarks/operators/** -text !eol
/benchmarks/validation/** -text !eol
/benchmarks/regressions/** -text !eol
