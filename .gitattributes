.gitattributes text eol=lf
.gitignore text eol=lf
/README.md text eol=lf
/AGENTS.md text eol=lf
/hgkda/** text eol=lf
/development/tools/** text eol=lf
/development/*.md text eol=lf
/development/tests/** text eol=lf
/development/reports/** text eol=lf
/development/manifests/** text eol=lf
# Frozen evidence, upstream snapshots and candidate byte identity.
/development/experiments/** -text !eol
/development/dependencies/** -text !eol
/development/tools/archive/** -text !eol
/hgkda/examples/** -text !eol
/operators/** -text !eol
*.zip filter=lfs diff=lfs merge=lfs -text !eol
*.tar filter=lfs diff=lfs merge=lfs -text !eol
*.tar.gz filter=lfs diff=lfs merge=lfs -text !eol
*.whl filter=lfs diff=lfs merge=lfs -text !eol
*.bin filter=lfs diff=lfs merge=lfs -text !eol
*.so filter=lfs diff=lfs merge=lfs -text !eol
*.npubin filter=lfs diff=lfs merge=lfs -text !eol
**/agent-events.jsonl filter=lfs diff=lfs merge=lfs -text !eol
