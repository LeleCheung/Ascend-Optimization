*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.whl filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text

# 项目运行源码使用 LF；原始评测与 profiler 附件保持采集字节。
project/Ascend-Optimization-v1/**/*.py text eol=lf
project/Ascend-Optimization-v1/**/*.sh text eol=lf
project/Ascend-Optimization-v1/operators/**/reports/** -text !eol

# 官方调研快照保持上游字节。
docs/msopprof-research/*.cpp -text !eol
docs/msopprof-research/*.h -text !eol
docs/msopprof-research/msopprof_performance_data.md -text !eol
